{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_DIRECT",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "INTERNAL_SECRET",
        "APP_URL",
        "APP_TIMEZONE",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "AUTHORIZED_EMAILS",
        "NEXT_PUBLIC_GOOGLE_AUTH_ENABLED",
        "SKILLSFORGE_DEV_AUTH"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
